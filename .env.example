# Supabase (database + production auth). Required in production.
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Server-only: privileged writes + workspace provisioning. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Demo storage: explicit opt-in ONLY. Defaults: true in development, false in production.
NEXT_PUBLIC_DEMO_PERSISTENCE=true

# Production dev bypass: honored ONLY when NODE_ENV=development AND this is "true".
ALLOW_DEV_AUTH=true
DEV_USER_ID=local-operator
DEV_USER_EMAIL=operator@local

# AI provider (server-only, OpenAI-compatible). Never prefix with NEXT_PUBLIC_.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini

# Business search (server-only). google = live Google Places; geoapify = live Geoapify (free key);
# overpass = live OpenStreetMap (no key, can be slow); demo = labeled simulations; auto = first configured.
BUSINESS_SEARCH_PROVIDER=auto
PLACES_API_KEY=
GEOAPIFY_API_KEY=

# Email sending (server-only)
RESEND_API_KEY=
EMAIL_FROM=Jarvis <noreply@example.com>

# Netlify deployment (server-only — never store in localStorage)
NETLIFY_TOKEN=
